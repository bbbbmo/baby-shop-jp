NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
# 도로명주소 "팝업 API" 승인키. 검색 API(addrLinkApi.do) 키와 서로 통하지 않는다 —
# 승인키는 API별·도메인별로 따로 발급된다. 검색 API 키를 넣으면 E0001이 난다.
JUSO_API_KEY=
# 결제 복귀 URL(PG가 손님을 다시 데려오는 주소)의 오리진. 배포처가 정해지면 그
# 도메인을 넣는다. 비워 두면 요청 URL의 오리진을 쓴다 — 로컬 개발은 그대로 동작한다.
# URL이 아닌 값을 넣으면 결제 시작 시점에 바로 예외가 난다.
SITE_URL=
